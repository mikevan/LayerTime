{"definition": "A configured time window is a rule parameter, not an observed event duration.", "definitionKind": "project-authored-interpretation-rule", "id": "configuration-not-measurement", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "No matches for selected packet types does not establish absence of all traffic or device activity.", "definitionKind": "project-authored-interpretation-rule", "id": "selected-absence-not-silence", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "A target identity is the addressed recipient; it does not by itself establish the sender or successful delivery.", "definitionKind": "project-authored-interpretation-rule", "id": "target-not-sender", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "A same-pair link requires the same client and the same network identity, not merely a familiar name or one matching address.", "definitionKind": "project-authored-interpretation-rule", "id": "pair-means-both-identities", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "An exchange before the requests is not a later exchange under a follow-on rule.", "definitionKind": "project-authored-interpretation-rule", "id": "order-before-link", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "A valid time-bounded match supports a correlation, not proof of causation or an outcome.", "definitionKind": "project-authored-interpretation-rule", "id": "correlation-not-cause", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "User-facing uncertainty should describe missing evidence; dataset review status belongs in provenance metadata.", "definitionKind": "project-authored-interpretation-rule", "id": "evidence-not-training-provenance", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
{"definition": "Explain the supplied policy without inventing or silently replacing thresholds when no policy change was requested.", "definitionKind": "project-authored-interpretation-rule", "id": "preserve-requested-policy", "independentExpertReview": false, "ontologySourceSha256": "57bdf2387170ea22e027a18292278c8c292c6d82a50c46098decdf8f1efe6746", "sourceId": "layertime-evidence-interpretation-principles-v1", "trainingApproved": false}
