{
  "name": "LayerTime-Sensors",
  "version": "1.0.0",
  "description": "Passive wireless threat detectors (BLE trackers, Flock, Axon, Flipper Zero, deauth bursts, Pineapple, multi-SSID, Pwnagotchi) for small radios. Plain C++17, no platform dependencies.",
  "keywords": "ble, wifi, 802.11, detection, tracker, counter-surveillance",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevan/LayerTime-Sensors.git"
  },
  "authors": [
    {
      "name": "Michael Van Geertruy",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0-or-later",
  "frameworks": "*",
  "platforms": "*",
  "headers": ["lts/Detectors.h", "lts/Candidate.h", "lts/Signatures.h", "lts/BleAdvertClassifier.h", "lts/WifiFrameClassifier.h"],
  "export": {
    "include": ["src", "library.json", "README.md", "LICENSE"]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  }
}
