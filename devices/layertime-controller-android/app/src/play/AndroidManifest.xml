<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build. Removes the accessibility service (the LOKMAT watch hardware button only) so the
     app is not subject to Google Play's AccessibilityService policy review. The service remains in the
     'full' sideload and watch build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".service.LayerTimeKeyService"
            tools:node="remove" />
    </application>
</manifest>
