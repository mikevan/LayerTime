{
  "name": "Deauth triage",
  "version": 1,
  "steps": [
    { "id": "event",   "type": "event_source",    "settings": { "window_ms": 10000 } },
    { "id": "target",  "type": "deauth_target" },
    { "id": "rate",    "type": "deauth_rate",      "settings": { "burst_frames": 6, "burst_ms": 3000 } },
    { "id": "reason",  "type": "deauth_reason" },
    { "id": "seq",     "type": "seq_integrity" },
    { "id": "signal",  "type": "signal_match",     "settings": { "tolerance_db": 8 } },
    { "id": "after",   "type": "aftermath",        "settings": { "watch_ms": 30000 } },
    { "id": "mfp",     "type": "mgmt_protection" },
    { "id": "verdict", "type": "deauth_verdict" }
  ],
  "edges": [
    { "from": "event",  "to": "target.frames",    "carries": "frames" },
    { "from": "event",  "to": "rate.frames",      "carries": "frames" },
    { "from": "event",  "to": "reason.frames",    "carries": "frames" },
    { "from": "event",  "to": "seq.frames",       "carries": "frames" },
    { "from": "event",  "to": "signal.frames",    "carries": "frames" },
    { "from": "event",  "to": "after.frames",     "carries": "frames" },
    { "from": "event",  "to": "mfp.frames",       "carries": "frames" },
    { "from": "target", "to": "verdict.features", "carries": "feature" },
    { "from": "rate",   "to": "verdict.features", "carries": "feature" },
    { "from": "reason", "to": "verdict.features", "carries": "feature" },
    { "from": "seq",    "to": "verdict.features", "carries": "feature" },
    { "from": "signal", "to": "verdict.features", "carries": "feature" },
    { "from": "after",  "to": "verdict.features", "carries": "feature" },
    { "from": "mfp",    "to": "verdict.features", "carries": "feature" }
  ]
}
