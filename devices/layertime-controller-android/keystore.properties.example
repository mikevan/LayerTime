# Template for release signing.
# Copy this file to keystore.properties (which is gitignored) and fill in your values.
# Use forward slashes in storeFile, even on Windows, so backslashes are not treated as escapes.
storeFile=C:/Users/you/.layerscope/layerscope-release.jks
storePassword=
keyAlias=layerscope
keyPassword=
